# Dependencies / build
node_modules/
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# Local environment & secrets — never committed
.env*
!.env.example

# Local databases (SQLite dev)
*.db
*.db-journal
*.db-wal
*.db-shm

# Local tooling & OS
.claude/
.DS_Store
npm-debug.log*
*.pem

# Private media storage (local adapter) — ROOT-ANCHORED so it only ignores the
# runtime media dir, NOT src/app/api/storage/ (an unanchored "storage/" silently
# excluded the signed-URL route from the repo — caught by CI).
/storage/

# Isolated test harness artifacts
.next-test/
test.db
test.db-*
