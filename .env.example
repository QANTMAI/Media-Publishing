# ─────────────────────────────────────────────────────────────────────────
# QANTM Media Portal — environment. Copy to .env for local dev.
# DO NOT COMMIT a filled-in .env. Production uses a secrets manager, not a file.
# The app validates this at boot (src/lib/server/config.ts) and, in production,
# refuses to start if a security-critical value is missing or weak.
#
# Generate the three base64 secrets with:
#   openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────

# Database. SQLite in every environment (dev/test/prod) — in prod, on a
# persistent volume with WAL + Litestream (see docs/DEPLOYMENT.md §3).
DATABASE_URL="file:./dev.db"

# Durability. Set DB_BACKUP_CONFIGURED=1 in production to acknowledge you've
# wired off-box backups (Litestream — see litestream.example.yml — or a
# `npm run db:backup` cron); otherwise the config guard warns at boot.
# db:backup writes to BACKUP_DIR (default ./backups), keeping BACKUP_KEEP (14).
DB_BACKUP_CONFIGURED=""
BACKUP_DIR=""
BACKUP_KEEP=""

# 32-byte secrets. Rotate for production; in prod, VAULT_MASTER_KEY is the
# KMS-managed master key that wraps the vault.
SESSION_SECRET=""          # JWT session signing key (>= 32 chars)
VAULT_MASTER_KEY=""        # AES-256-GCM master key — MUST decode to exactly 32 bytes
STORAGE_SIGNING_KEY=""     # signs expiring media URLs (>= 32 bytes)

# Media storage (T-106): private files served only via signed expiring URLs.
STORAGE_DIR="storage"
PUBLIC_ORIGIN=""           # e.g. https://portal.example.com — REQUIRED in prod (signed media / real IG publishing)

# Meta (Instagram + Facebook + Threads share one app) — fill in after app review.
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI=""       # https://<PUBLIC_ORIGIN>/api/oauth/meta/callback

# LinkedIn (member posting). Create an app at developer.linkedin.com, add the
# self-serve products "Sign In with LinkedIn using OpenID Connect" and
# "Share on LinkedIn", then add the redirect URL on the app's Auth tab:
#   <origin>/api/oauth/linkedin/callback
# All three required together, or none. Optional: LINKEDIN_API_VERSION
# (YYYYMM) overrides the pinned versioned-API month when LinkedIn sunsets it.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI=""

# YouTube (video upload). Create an OAuth client at console.cloud.google.com
# (enable the "YouTube Data API v3", configure the consent screen, add scopes
# youtube.upload + youtube.readonly), set the authorized redirect URI:
#   <origin>/api/oauth/youtube/callback
# All three required together, or none. Note: until the app passes YouTube's
# API compliance audit, uploads are locked to PRIVATE (add your Google account
# as a test user to publish while unaudited).
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI=""

# With no platform app configured, the connect flows run in clearly-labeled
# MOCK mode so the UI is testable end-to-end. Set to 0 for real OAuth (then
# the META_* / LINKEDIN_* / YOUTUBE_* values above are required for their platforms).
OAUTH_MOCK="1"

# Email notifications (optional). Set BOTH to enable; leave BOTH empty to
# disable (the app then records notifications in-app only and says so).
#   SMTP_URL="smtps://user:pass@smtp.example.com:465"
SMTP_URL=""
SMTP_FROM=""               # e.g. "QANTM Media <no-reply@example.com>"

# Trust the X-Forwarded-For header for audit IPs. Set to 1 ONLY behind a proxy
# you control that overwrites the header — otherwise audit IPs are spoofable.
TRUST_PROXY=""

# Dev-only 2FA bypass (non-production only). 1 = enable /api/auth/dev-login.
# MUST be unset in production — the config guard aborts the boot if it's on.
AUTH_DEV_BYPASS=""

# Note: AI provider keys (Anthropic) are NOT env vars — the operator adds them
# in-app under Settings → Integrations & keys, stored encrypted in the vault.
